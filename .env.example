# =============================================================================
# Unmad Digital Archive — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
# Generate a fresh key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-me-with-a-long-random-string

# Set DEBUG=False in production. Affects template error pages, static serving, etc.
DEBUG=True

# Comma-separated list of hostnames Django will respond to.
ALLOWED_HOSTS=127.0.0.1,localhost


# -----------------------------------------------------------------------------
# Supabase Storage (S3-compatible)
#
# Leave USE_SUPABASE_STORAGE=False to keep all uploads in local /media/.
# Flip to True once both buckets exist on Supabase and credentials are filled.
#
# Where to find these values:
#   Supabase Dashboard -> Project Settings -> Storage -> S3 Connection
# -----------------------------------------------------------------------------
USE_SUPABASE_STORAGE=False

# S3 endpoint for your project. Format:
#   https://<project_ref>.storage.supabase.co/storage/v1/s3
SUPABASE_S3_ENDPOINT_URL=

# Region of your Supabase project (matches the dashboard, e.g. ap-southeast-1).
SUPABASE_S3_REGION=ap-southeast-1

# Access key + secret from the S3 Connection panel.
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# Two buckets — Supabase enforces visibility at the bucket level.
#   * Public bucket  -> cover images, served as plain public URLs.
#   * Private bucket -> PDF files, served as short-lived signed URLs.
SUPABASE_PUBLIC_BUCKET=unmad-archive
SUPABASE_PRIVATE_BUCKET=unmad-archive-pdfs

# Lifetime (in seconds) of the signed URLs generated for PDFs.
# 3600 = 1 hour. Lower it for production once auth-gated download views land.
SUPABASE_SIGNED_URL_EXPIRE=3600
